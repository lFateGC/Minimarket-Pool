# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — MINIMARKET POOL
# ==============================================================================
# Copia este archivo como '.env' en la raíz y completa tus credenciales.

# 1. SERVIDOR
SERVER_PORT=8080

# 2. SEGURIDAD & JWT (Generar clave HMAC-SHA de 512 bits)
JWT_SECRET=tu-clave-secreta-jwt-de-512-bits-aqui
JWT_EXPIRATION_MS=86400000

# 3. SUPABASE CLOUD (Almacenamiento de fotos de productos)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_BUCKET_NAME=productos-minimarket
SUPABASE_PUBLIC_URL_BASE=https://tu-proyecto.supabase.co/storage/v1/object/public/productos-minimarket/

# 4. BASE DE DATOS (H2 Local o PostgreSQL Remoto de Supabase)
DB_URL=jdbc:h2:file:./data/gestion_inventario;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
DB_DIALECT=org.hibernate.dialect.H2Dialect
